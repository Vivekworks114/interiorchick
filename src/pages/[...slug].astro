---
import { getCollection, render } from 'astro:content';
import { allSiteSlugs, getPage, getCategoryItems } from '../data/pages';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import ProductPageLayout from '../layouts/ProductPageLayout.astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { prepareProductHtml } from '../utils/product-page';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';

const htmlModules = import.meta.glob<string>('../data/page-html/*.html', {
  eager: true,
  query: '?raw',
  import: 'default',
});

function getPageHtml(slug: string): string | undefined {
  return htmlModules[`../data/page-html/${slug}.html`];
}

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const pageEntries = await getCollection('pages');

  const blogPaths = blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'blog' as const, entry },
  }));

  const pagePaths = pageEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'page' as const, entry },
  }));

  const covered = new Set([
    ...blogEntries.map((e) => e.id),
    ...pageEntries.map((e) => e.id),
    'contact',
    'home',
    'blog',
    'laatste-blogs',
    'sitemap',
  ]);

  const legacyPaths = allSiteSlugs
    .filter((slug) => !covered.has(slug))
    .map((slug) => ({
      params: { slug },
      props: { type: 'legacy' as const, slug },
    }));

  return [...blogPaths, ...pagePaths, ...legacyPaths];
}

const props = Astro.props;

function createFallbackPage(slug: string) {
  const title = slug
    .replace(/^beste-/, '')
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');

  const isProduct = slug.startsWith('beste-');

  return {
    slug,
    title: isProduct ? `Beste ${title}` : title,
    description: `Lees alles over ${title.toLowerCase()} op InteriorChick.nl.`,
    featuredImage: '/images/2023/06/digitale-wekker.jpeg',
    content: `<p>Welkom op InteriorChick.nl. In dit artikel delen we onze tips en ervaringen over ${title.toLowerCase()}. Bekijk regelmatig onze site voor de nieuwste productvergelijkingen en interieurtips.</p>`,
  };
}

const categoryHubs = [
  'slaapkamer',
  'interieur',
  'wasruimte',
  'keuken',
  'terras',
  'veiligheid',
  'melders',
];

const legacyPage =
  props.type === 'legacy'
    ? getPage(props.slug) ?? createFallbackPage(props.slug)
    : null;

const categoryItems =
  props.type === 'page' ? getCategoryItems(props.entry.id) : [];

const isCategoryHub =
  props.type === 'page' && categoryHubs.includes(props.entry.id);

const slug =
  props.type === 'blog' || props.type === 'page' ? props.entry.id : props.slug;

const rawPageHtml = getPageHtml(slug);

const isProductPage =
  props.type === 'page' &&
  (props.entry.data.pageType === 'product' || props.entry.id.startsWith('beste-'));

const pageHtml =
  rawPageHtml && isProductPage
    ? prepareProductHtml(rawPageHtml, props.entry.id)
    : rawPageHtml;

const { Content } =
  props.type === 'blog' ? await render(props.entry) : { Content: null };
---
{props.type === 'blog' && Content && (
  <BlogPostLayout entry={props.entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </BlogPostLayout>
)}

{props.type === 'page' && isProductPage && (
  <ProductPageLayout entry={props.entry}>
    <Header slot="header" />
    {pageHtml ? <div set:html={pageHtml} /> : <p class="container">Content niet beschikbaar.</p>}
    <Footer slot="footer" />
  </ProductPageLayout>
)}

{props.type === 'page' && !isProductPage && (
  <ContentPageLayout entry={props.entry}>
    <Header slot="header" />
    {pageHtml ? <div class="wp-content" set:html={pageHtml} /> : <p>Content niet beschikbaar.</p>}
    {isCategoryHub && categoryItems.length > 0 && (
      <div class="container category-grid">
        <div class="card-grid">
          {categoryItems.map((item) => (
            <ArticleCard
              slug={item.href.replace(/^\/|\/$/g, '')}
              title={item.title}
              image={item.image}
              alt={item.alt}
            />
          ))}
        </div>
      </div>
    )}
    <Footer slot="footer" />
  </ContentPageLayout>
)}

{props.type === 'legacy' && legacyPage && (
  <ArticleLayout
    title={legacyPage.title}
    description={legacyPage.description}
    image={legacyPage.featuredImage}
  >
    <Header slot="header" />
    <div set:html={legacyPage.content} />
    <Footer slot="footer" />
  </ArticleLayout>
)}

<style>
  .category-grid {
    padding-bottom: 3rem;
  }
</style>
