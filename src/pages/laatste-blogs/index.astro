---
import PageLayout from '../../layouts/PageLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogListing from '../../components/BlogListing.astro';
import { getCollection } from 'astro:content';

const POSTS_PER_PAGE = 12;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice(0, POSTS_PER_PAGE);
---
<PageLayout
  title="Laatste blogs"
  description="Laat je inspireren door onze blogs geschreven door interieurdesigners op InteriorChick.nl."
>
  <Header slot="header" />
  <BlogListing posts={posts} currentPage={1} totalPages={totalPages} />
  <Footer slot="footer" />
</PageLayout>
